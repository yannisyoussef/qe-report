# Every setting the reference deployment reads, with placeholder values. Copy it to `.env` beside
# compose.yaml and edit. It holds no secret: the two credentials are files, created separately.
#
#   cp env.example .env
#   ./scripts/secrets.sh            # writes ./secrets/*, never committed
#   ./scripts/dev-tls.sh localhost  # a rehearsal certificate; in production, use your own
#
# Nothing in this file is a secret, and nothing under ./secrets, ./tls, or ./backups belongs in
# version control. See .gitignore beside this file.
#
# Settings marked "fixed by the image or compose.yaml" are listed because the application reads
# them and an operator should know they exist, not because this file is where to change them:
# changing them means editing compose.yaml, where the paths and the network they describe are set.

# ---------------------------------------------------------------------------------------------
# The image this deployment runs
# ---------------------------------------------------------------------------------------------
# Built from this checkout by `docker compose build api`, or a tag you built elsewhere.
QE_REPORT_IMAGE=qe-report:local
# Recorded as an OCI label so a running container can be traced to a commit. A backup reads the
# label from the image that was serving, not from this file.
SOURCE_REVISION=unknown

# ---------------------------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------------------------
POSTGRES_DB=qe_report
POSTGRES_USER=qe_report
# The password itself lives in ./secrets/postgres_password, and the API's whole connection string
# in ./secrets/database_url. The database port is never published to the host.
POSTGRES_MEMORY=1g
POSTGRES_CPUS=1.0

# ---------------------------------------------------------------------------------------------
# How the API finds the database
# ---------------------------------------------------------------------------------------------
# Exactly one of these two, and an empty value still counts as set: a process that found both
# would have to guess which one its operator meant, and it refuses to.
#
#   DATABASE_URL_FILE   the path to a file holding the whole connection string. What a container
#                       uses, and what compose.yaml sets: /run/secrets/database_url.
#   DATABASE_URL        the connection string itself. For running the binary outside a container.
#
# A password containing a reserved character must be percent-encoded, as PostgreSQL's own
# documentation requires. Fixed by compose.yaml.
# DATABASE_URL_FILE=/run/secrets/database_url
# DATABASE_URL=postgres://user:password@host:5432/qe_report

# ---------------------------------------------------------------------------------------------
# The API
# ---------------------------------------------------------------------------------------------
QE_REPORT_LOG_LEVEL=info
# The largest request the application will accept, in bytes. 512 MiB here; the default in the
# binary is 1 GiB.
QE_REPORT_MAX_REQUEST_BYTES=536870912
# How long a shutdown may take before it is abandoned. It must be shorter than the api service's
# stop_grace_period in compose.yaml (45s), so the application's own drain is what decides. An
# upload still running when it expires is abandoned, and the producer retries it.
QE_REPORT_SHUTDOWN_GRACE_MS=30000
QE_REPORT_MEMORY=1g
QE_REPORT_CPUS=1.0

# Where the durable state lives inside the container, and where it listens. Fixed by the image and
# compose.yaml: the two roots are separate volumes, and the port is private to the deployment
# network, which is why the server binds every interface inside the container.
# QE_REPORT_BLOB_ROOT=/var/lib/qe-report/blobs
# QE_REPORT_STAGING_ROOT=/var/lib/qe-report/staging
# QE_REPORT_HOST=0.0.0.0
# QE_REPORT_PORT=8080

# The rest of the transport limits, with the binary's defaults. QE_REPORT_MAX_REQUEST_BYTES above
# is the ceiling on a whole request; these bound its parts, so that one absurd member of an
# otherwise ordinary upload is refused on its own terms. Each must be a positive whole number.
# QE_REPORT_MAX_EVENT_PARTS=64
# QE_REPORT_MAX_EVENT_BYTES=268435456
# QE_REPORT_MAX_ATTACHMENT_PARTS=256
# QE_REPORT_MAX_ATTACHMENT_BYTES=67108864
# QE_REPORT_MAX_TOTAL_ATTACHMENT_BYTES=536870912
# QE_REPORT_MAX_JSON_BODY_BYTES=65536

# ---------------------------------------------------------------------------------------------
# The TLS edge
# ---------------------------------------------------------------------------------------------
# The only published port in the deployment.
QE_REPORT_PUBLIC_PORT=8443
# The name on the certificate. A rehearsal uses localhost; a real deployment uses its hostname.
QE_REPORT_SERVER_NAME=localhost
# Where server.crt and server.key are read from, read-only. Supply them however your organisation
# issues certificates; automatic issuance is not part of this reference.
QE_REPORT_TLS_DIR=./tls

# The edge's own body limit, deliberately larger than QE_REPORT_MAX_REQUEST_BYTES above. The two
# are separate protections and are meant to stay separable: the edge refuses what is absurd, with
# nginx's own 413, and a body between the two limits reaches the application and is refused there
# as a problem document. Making them equal hides the second one. Raise both together, keeping this
# the larger, and remember the edge writes the body through rather than buffering it.
QE_REPORT_EDGE_MAX_BODY=544m

# Requests one client address may make, and how many may queue. These are the deployment's abuse
# controls, not authentication: a valid key is subject to them too.
#
# 30r/m is half a request a second sustained. That suits a handful of producers; a CI fleet needs
# more, and a fleet behind one NAT address counts as one client here, because per-address means per
# address the edge can see. Raise it, or put a real identity in front of it.
QE_REPORT_EDGE_RATE=30r/m
QE_REPORT_EDGE_RATE_BURST=20
# Health and readiness have their own allowance, so a probe never spends a client's.
QE_REPORT_EDGE_HEALTH_RATE=60r/m
# The Retry-After the edge sends with a 429, in seconds. The producer honours it.
QE_REPORT_EDGE_RETRY_AFTER=2
# Simultaneous connections one client address may hold.
QE_REPORT_EDGE_CONNECTIONS=16
# How long the edge waits on a slow upload or a slow answer. A run of the maximum size on a slow
# link takes minutes; a generic few-second API timeout would break it.
QE_REPORT_EDGE_READ_TIMEOUT=600s
# The DNS the edge resolves `api` with, so a recreated API container is found without a reload.
# Docker's embedded resolver, on every user-defined network.
QE_REPORT_EDGE_RESOLVER=127.0.0.11
QE_REPORT_EDGE_MEMORY=256m
QE_REPORT_EDGE_CPUS=0.5

# ---------------------------------------------------------------------------------------------
# Operator paths on the host
# ---------------------------------------------------------------------------------------------
QE_REPORT_SECRET_DIR=./secrets
QE_REPORT_BACKUP_DIR=./backups
# A ceiling on how long a backup may hold the maintenance lock, in seconds. It is released as soon
# as the backup is done; this only bounds what a backup that died could leave behind.
QE_REPORT_BACKUP_LOCK_SECONDS=3600
