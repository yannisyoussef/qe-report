{
  "name": "qe-report-http-api",
  "version": "0.1.0",
  "description": "qe-report authenticated HTTP transport: project-scoped API keys over the durable run store and query indexes",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "qe-report-server": "./dist/bin/server.js",
    "qe-report-admin": "./dist/bin/admin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:junit-runs": "vitest run --config vitest.runs.config.ts test-runs/junit-runs.test.ts",
    "test:playwright-runs": "vitest run --config vitest.runs.config.ts test-runs/playwright-runs.test.ts",
    "openapi": "node scripts/openapi.mjs",
    "openapi:check": "node scripts/openapi.mjs --check"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/pg": "8.23.1",
    "ajv-formats": "3.0.1",
    "testcontainers": "12.1.0"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.1",
    "ajv": "8.20.0",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "qe-report-blob-fs": "workspace:*",
    "qe-report-postgres": "workspace:*",
    "qe-report-protocol": "workspace:*",
    "qe-report-read-model": "workspace:*",
    "qe-report-validator": "workspace:*"
  }
}
