{
  "name": "qe-report-playwright",
  "version": "0.1.0",
  "description": "qe-report reporter for Playwright Test",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:consumer": "vitest run --config vitest.consumer.config.ts"
  },
  "dependencies": {
    "qe-report-http-client": "workspace:*",
    "qe-report-sdk": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.57.0 <2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "qe-report-protocol": "workspace:*",
    "qe-report-validator": "workspace:*"
  }
}
