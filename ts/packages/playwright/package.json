{
  "name": "qe-report-playwright",
  "version": "1.0.0",
  "description": "qe-report reporter for Playwright Test",
  "license": "Apache-2.0",
  "homepage": "https://github.com/yannisyoussef/qe-report#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yannisyoussef/qe-report.git",
    "directory": "ts/packages/playwright"
  },
  "bugs": {
    "url": "https://github.com/yannisyoussef/qe-report/issues"
  },
  "author": "Yannis BA BINENI",
  "keywords": [
    "qe-report",
    "test-reporting",
    "test-results",
    "playwright",
    "playwright-reporter"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:consumer": "vitest run --config vitest.consumer.config.ts"
  },
  "dependencies": {
    "qe-report-http-client": "workspace:*",
    "qe-report-sdk": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.57.0 <2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "qe-report-protocol": "workspace:*",
    "qe-report-validator": "workspace:*"
  }
}
