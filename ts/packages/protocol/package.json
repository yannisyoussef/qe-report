{
  "name": "qe-report-protocol",
  "version": "1.0.0",
  "description": "qe-report protocol types and JSON codec (compatibility line 0.3)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/yannisyoussef/qe-report#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yannisyoussef/qe-report.git",
    "directory": "ts/packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/yannisyoussef/qe-report/issues"
  },
  "author": "Yannis BA BINENI",
  "keywords": [
    "qe-report",
    "test-reporting",
    "test-results"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
