{
  "name": "qe-report-validator",
  "version": "1.0.0",
  "description": "Validates a qe-report protocol event file",
  "license": "Apache-2.0",
  "homepage": "https://github.com/yannisyoussef/qe-report#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yannisyoussef/qe-report.git",
    "directory": "ts/packages/validator"
  },
  "bugs": {
    "url": "https://github.com/yannisyoussef/qe-report/issues"
  },
  "author": "Yannis BA BINENI",
  "keywords": [
    "qe-report",
    "test-reporting",
    "test-results",
    "json-schema",
    "validation"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "qe-report-validate": "./dist/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "schema"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/copy-schema.mjs && tsdown",
    "typecheck": "node ./scripts/copy-schema.mjs && tsc --noEmit -p tsconfig.json",
    "test": "node ./scripts/copy-schema.mjs && vitest run"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "qe-report-protocol": "workspace:*"
  }
}
