{
  "name": "qe-report-validator",
  "version": "0.1.0",
  "description": "Validates a qe-report protocol event file",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ./scripts/copy-schema.mjs && tsdown",
    "typecheck": "node ./scripts/copy-schema.mjs && tsc --noEmit -p tsconfig.json",
    "test": "node ./scripts/copy-schema.mjs && vitest run"
  },
  "bin": {
    "qe-report-validate": "./dist/cli.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "qe-report-protocol": "workspace:*"
  }
}
