{
  "name": "qe-report-read-model",
  "version": "0.1.0",
  "description": "qe-report read model: validation-first projection of run directories into runs, test histories, and flakiness",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:junit-runs": "vitest run --config vitest.runs.config.ts test-runs/junit-runs.test.ts",
    "test:playwright-runs": "vitest run --config vitest.runs.config.ts test-runs/playwright-runs.test.ts"
  },
  "dependencies": {
    "qe-report-protocol": "workspace:*",
    "qe-report-validator": "workspace:*"
  }
}
